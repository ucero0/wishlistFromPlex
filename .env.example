# =============================================================================
# Copy this file to .env and edit values before: docker compose up
#
# Compose:
#   Development: docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build
#   Production:  docker compose -f docker-compose.yml up -d --build
# Guide: docs/DOCKER_SETUP.md
# Use KEY=value (no spaces around =)
# =============================================================================

# --- API & database (required) ---
DATABASE_URL=postgresql://plex_wishlist_user:plex_wishlist_pass@db:5432/plex_wishlist
API_KEY=change-me-to-a-long-random-string
POSTGRES_USER=plex_wishlist_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plex_wishlist

# --- App ---
LOG_LEVEL=INFO
PLEX_SYNC_INTERVAL_HOURS=6
PLEX_LIBRARY_PATHS_SYNC_INTERVAL_HOURS=6

# --- NordVPN / Gluetun (required for Deluge + Prowlarr) ---
NORDVPN_USER=your_nordvpn_openvpn_username
NORDVPN_PASSWORD=your_nordvpn_openvpn_password
SERVER_COUNTRIES=Switzerland,Spain

# --- Deluge (RPC via gluetun — not hostname "deluge") ---
# Set a strong password BEFORE the first `docker compose up` — init script applies it to RPC + Web UI.
DELUGE_HOST=gluetun
DELUGE_PORT=58846
DELUGE_USERNAME=deluge
DELUGE_PASSWORD=change-me-strong-password
# Optional: Web UI password (defaults to DELUGE_PASSWORD). Login user is always "admin".
# DELUGE_WEB_PASSWORD=
# Set to true once to overwrite Web UI password after bootstrap (then remove or set false).
# DELUGE_FORCE_WEB_PASSWORD=
CONTAINER_DELUGE_QUARANTINE_PATH=/downloads/quarantine
# Free space buffer before adding torrents (GB); default estimate when size unknown
DOWNLOAD_MIN_FREE_BUFFER_GB=10
DOWNLOAD_DEFAULT_REQUIRED_GB=50
DEFERRED_DOWNLOAD_PROCESS_INTERVAL_MINUTES=15
# Use DB disk stats for ingest destination when younger than this (hours)
PLEX_LIBRARY_DISK_STATS_MAX_AGE_HOURS=6

# --- Prowlarr (via gluetun) ---
# Must match <ApiKey> in infra/prowlarr/config/config.xml
PROWLARR_HOST=gluetun
PROWLARR_PORT=9696
PROWLARR_API_KEY=change-me-match-config-xml-api-key

# --- FlareSolverr (via gluetun — env only, no config volume) ---
FLARESOLVERR_LOG_LEVEL=info
FLARESOLVERR_CAPTCHA_SOLVER=none

# --- Plex (pick ONE mode — see docs/DOCKER_SETUP.md) ---
#
# Mode A — Plex installed on your PC (default stack, no plex container):
#   PLEX_SERVER_URL=http://host.docker.internal:32400
#   Start: docker compose up -d
#   Mount library folders on fastapi only (same host paths Plex uses on Windows).
#
# Mode B — Plex runs in Docker (optional profile):
#   PLEX_SERVER_URL=http://plex:32400
#   PLEX_CLAIM=claim-xxxx   # one-time, fresh install only
#   Start: docker compose --profile plex-docker up -d
#   Mount library folders on both plex and fastapi in docker-compose.yml.
#
PLEX_SERVER_URL=http://host.docker.internal:32400
PLEX_SERVER_ADMIN_TOKEN=
PLEX_CLAIM=

# --- Optional ---
TMDB_API_KEY=
SCANFORVIRUS_API_URL=http://fastapi:8000/antivirus/scan/torrent

# --- Host paths (bind mounts) ---
# Plex library folders are configured in the Plex UI and mounted in docker-compose.yml
# (not here). FastAPI needs the same paths for ingest moves and disk-usage checks.
DELUGE_QUARANTINE_VOLUME_PATH=./infra/deluge/downloads/quarantine
