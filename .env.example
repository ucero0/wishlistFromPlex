# =============================================================================
# Copy this file to .env and edit values before: docker compose up
#
# Compose:
#   VPN stack (default):     docker compose up -d --build
#   No-VPN stack (local dev): docker compose -f docker-compose.no-vpn.yml up -d --build
#   Development + hot reload: docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build
# Guide: docs/DOCKER_SETUP.md
# Use KEY=value (no spaces around =)
# =============================================================================

# Database Configuration
DATABASE_URL=postgresql://plex_orchestrator_user:change-me@postgres:5432/plex_orchestrator

# API Security
API_KEY=change-me-to-a-long-random-string

# Sync Configuration
PLEX_SYNC_INTERVAL_HOURS=6
PLEX_LIBRARY_PATHS_SYNC_INTERVAL_HOURS=6

# Logging
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=plex_orchestrator_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plex_orchestrator

# NordVPN Credentials (required for default docker-compose.yml; omit for no-vpn stack)
NORDVPN_USER=your_nordvpn_openvpn_username
NORDVPN_PASSWORD=your_nordvpn_openvpn_password
SERVER_COUNTRIES=Netherlands,Germany

# Deluge
# FastAPI RPC: DELUGE_HOST=gluetun (VPN) or deluge (no-vpn overlay)
DELUGE_HOST=gluetun
DELUGE_PORT=58846
DELUGE_WEB_PORT=8112
DELUGE_USERNAME=deluge
DELUGE_PASSWORD=change-me-strong-password
# Web UI password (defaults to DELUGE_PASSWORD). Login user is always "admin".
DELUGE_WEB_PASSWORD=
# Set to true once to re-apply Web UI password from env, then set back to false.
DELUGE_FORCE_WEB_PASSWORD=
CONTAINER_DELUGE_QUARANTINE_PATH=/downloads/quarantine
# Free space buffer before adding torrents (GB); default estimate when size unknown
DOWNLOAD_MIN_FREE_BUFFER_GB=10
DOWNLOAD_DEFAULT_REQUIRED_GB=50
DEFERRED_DOWNLOAD_PROCESS_INTERVAL_MINUTES=15
# Poll Deluge for completed torrents (ingest) and stuck/unhealthy torrents (blacklist + re-queue)
INGEST_POLL_INTERVAL_MINUTES=5
TORRENT_UNHEALTHY_MIN_AVAILABILITY=1
TORRENT_UNHEALTHY_MIN_AVAILABILITY_ACTIVE_DAYS=1
TORRENT_UNHEALTHY_NO_TRANSFER_DAYS=5
# Legacy Deluge Execute plugin hook; leave unset/false when using scheduler ingest poll
# DELUGE_EXECUTE_INGEST_HOOK=false
PLEX_LIBRARY_DISK_STATS_MAX_AGE_HOURS=6
# How long cached HDD free space in the DB is trusted for non-ingest reads (ingest always refreshes live stats first)

# Prowlarr
# FastAPI API client: PROWLARR_HOST=gluetun (VPN) or prowlarr (no-vpn)
PROWLARR_HOST=gluetun
PROWLARR_PORT=9696
PROWLARR_API_KEY=change-me-to-a-long-random-string
# Bootstrap → Deluge Web UI (VPN: 127.0.0.1 via gluetun namespace; no-VPN: deluge)
PROWLARR_BOOTSTRAP_DELUGE_HOST=127.0.0.1
# No-VPN overlay: PROWLARR_BOOTSTRAP_DELUGE_HOST=deluge
# FlareSolverr is off VPN on both stacks (compose default):
# FLARESOLVERR_URL=http://flaresolverr:8191
# PROWLARR_DELUGE_CATEGORY=prowlarr
# PROWLARR_BOOTSTRAP_FORCE=false

# FlareSolverr (VPN stack: http://127.0.0.1:8191 — shares Gluetun with Prowlarr)
FLARESOLVERR_PORT=8191
FLARESOLVERR_URL=http://127.0.0.1:8191
FLARESOLVERR_LOG_LEVEL=info
FLARESOLVERR_CAPTCHA_SOLVER=none
FLARESOLVERR_REQUEST_TIMEOUT=120
FLARESOLVERR_BROWSER_TIMEOUT=120000

# Plex
# Mode A — Plex on host: PLEX_SERVER_URL=http://host.docker.internal:32400
# Mode B — Plex in Docker: PLEX_SERVER_URL=http://plex:32400 and docker compose --profile plex-docker up -d
PLEX_SERVER_URL=http://host.docker.internal:32400
PLEX_SERVER_ADMIN_TOKEN=
PLEX_CLAIM=
CONTAINER_PLEX_MEDIA_PATH=/plex/media
# Docker: Plex library paths are resolved under this prefix (bind-mount host root at /host)
CONTAINER_HOST_FS_PREFIX=/host
# HOST_FS_BIND_SOURCE=/

# FastAPI / Deluge hook
# Called when a torrent completes (see infra/deluge/scripts/on-torrent-complete.sh)
SCANFORVIRUS_API_URL=http://plex-orchestrator:8000/pipelines/ingest/scan-and-ingest

# TMDB
TMDB_API_KEY=
# v4 read access token from https://www.themoviedb.org/settings/api (watchlist sync)
TMDB_ACCESS_TOKEN=
TMDB_USER_NAME=default
# TMDB_ACCOUNT_ID=

# Volume Paths (host bind mounts)
PLEX_MEDIA_VOLUME_PATH=./infra/plex/media
DELUGE_QUARANTINE_VOLUME_PATH=./infra/deluge/downloads/quarantine
